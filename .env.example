# === Mode ===
# true = single-user (current behavior, no auth needed)
# false = multi-user (public instance, requires SERVER_SECRET)
SINGLE_USER_MODE=true

# === Required for SINGLE_USER_MODE ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# === Required for multi-user mode ===
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SERVER_SECRET=

# === Limits (multi-user mode) ===
# MAX_USER_CONTEXTS=50
# MAX_CONCURRENT_JOBS=10
# MAX_MESSAGES_PER_JOB=50000
# SESSION_EXPIRY_DAYS=7
# MAX_SESSIONS_PER_USER=3

# === Logging ===
# LOG_LEVEL=INFO
# LOG_FILE=  (leave empty for stdout-only, recommended for Docker)

# === Paths (usually no need to change) ===
# SESSION_DIR=./sessions
# DB_PATH=./data.db

# === Production (docker-compose.prod.yml) ===
# Domain Caddy serves on. Leave empty or 'localhost' for local Docker.
# DOMAIN=tgmigrate.com

# Caddy TLS mode. Leave unset for automatic Let's Encrypt (default).
# Set to 'tls internal' when behind Cloudflare proxy in "Full" mode
# (CF terminates real TLS at the edge; Caddy uses a self-signed cert).
# TLS_MODE=tls internal

# Comma-separated list of origins allowed by CORS.
# Required in production when SPA and API share a domain.
# Defaults to localhost dev origins when unset.
# CORS_ORIGINS=https://tgmigrate.com
